{
  "name": "cafe",
  "version": "0.1.0",
  "private": true,
  "main": "index.native.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "api": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "web": "webpack serve --mode development --host 127.0.0.1",
    "build": "webpack --mode production",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "native": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "format": "prettier --write src server test scripts app.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "prepare:hosting": "node scripts/prepare-hosting.mjs",
    "migrate:sqlite": "node --env-file-if-exists=.env --import tsx scripts/migrate-sqlite.ts",
    "verify:services": "node --env-file-if-exists=.env --import tsx scripts/verify-services.ts",
    "test:mysql": "node --import tsx scripts/test-mysql.ts",
    "build:aws": "node scripts/build-aws.mjs",
    "deploy:aws": "npm run build:aws && node scripts/deploy-aws.mjs",
    "test:dynamodb": "node scripts/test-dynamodb.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@emotion/native": "latest",
    "@emotion/react": "latest",
    "@expo-google-fonts/inter": "0.4.2",
    "@fontsource/inter": "5.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "latest",
    "expo-device": "latest",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-image-picker": "58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "latest",
    "expo-updates": "~58.0.22",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "latest",
    "react-native-svg": "15.16.0",
    "react-native-web": "latest",
    "stripe": "latest",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.2.1",
    "eas-cli": "latest",
    "esbuild": "0.28.2",
    "esbuild-loader": "latest",
    "html-webpack-plugin": "^5.6.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
