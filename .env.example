# Local development: configure MySQL first, then DEV_DEMO=1 npm run dev.
DEV_DEMO=0
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8080
# Empty for Amplify/root hosting; optional /cafe for conventional subfolder hosting.
APP_BASE_PATH=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cafe
MYSQL_USER=cafe
MYSQL_PASSWORD=
# Enable TLS for a remote database, optionally with the provider's CA file.
MYSQL_SSL=0
MYSQL_SSL_CA=
# Optional local Unix socket; leave blank on ordinary TCP hosting.
MYSQL_SOCKET=

EMAIL_TRANSPORT=smtp
SMTP_HOST=mail.anchortag.com.au
SMTP_PORT=465
SMTP_USER=contact@anchortag.com.au
SMTP_PASSWORD=
SMTP_FORCE_IPV4=1
EMAIL_FROM=contact@anchortag.com.au
# Optional legacy email transport when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_EAS_PROJECT_ID=
IOS_BUNDLE_ID=com.yourcompany.cafe
ANDROID_PACKAGE=com.yourcompany.cafe
APP_NAME=Cafe
APP_SLUG=cafe
APP_SCHEME=cafe
CAFE_STORE_ID=
GOOGLE_SERVICES_FILE=
EXPO_ACCESS_TOKEN=
TRUST_PROXY=0
DOMAIN=
