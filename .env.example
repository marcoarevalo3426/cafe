# Local demo: DEV_DEMO=1 npm run dev
DEV_DEMO=0
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8080
DATABASE_PATH=data/cafe.sqlite

# Required for real email sign-in. Use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=

# Required for real cards and eligible Apple Pay / Google Pay wallets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Native app build configuration (never put private keys in EXPO_PUBLIC variables).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_EAS_PROJECT_ID=
IOS_BUNDLE_ID=com.yourcompany.cafe
ANDROID_PACKAGE=com.yourcompany.cafe
APP_NAME=Cafe
APP_SLUG=cafe
APP_SCHEME=cafe
CAFE_STORE_ID=
# Path to google-services.json for native Android builds, outside source control.
GOOGLE_SERVICES_FILE=
# Optional Expo push service access token, server-only.
EXPO_ACCESS_TOKEN=
# Set to 1 only behind one trusted reverse proxy, such as the bundled Caddy.
TRUST_PROXY=0
# Production compose: DOMAIN=cafe.example.com and APP_ORIGIN=https://cafe.example.com
DOMAIN=
